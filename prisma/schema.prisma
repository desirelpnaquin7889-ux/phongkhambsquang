generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id         Int      @id @default(autoincrement())
  patientName String
  phone      String
  service    String
  date       String
  timeSlot   String
  notes      String?
  status     String   @default("pending") // pending | confirmed | completed | cancelled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("appointments")
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  icon        String
  active      Boolean @default(true)
  order       Int     @default(0)

  @@map("services")
}

model Doctor {
  id          Int     @id @default(autoincrement())
  name        String
  credentials String
  specialty   String
  bio         String
  imageUrl    String?
  tags        String  // JSON array as string
  active      Boolean @default(true)
  order       Int     @default(0)

  @@map("doctors")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  message   String?
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  initials  String
  stars     Int      @default(5)
  text      String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}
